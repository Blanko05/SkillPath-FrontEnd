# Copy this file to .env and fill in real values. .env is gitignored.

# Backend API URL. Leave unset for local dev - defaults to
# http://localhost:5000/api. Set to your deployed backend's URL
# (e.g. https://your-app.onrender.com/api) for production builds.
VITE_API_URL=

# Free key from Google Cloud Console -> enable "YouTube Data API v3" -> Credentials -> API key.
# Powers the "Related videos" panel on the course detail page.
# Without this set, that panel just doesn't render - nothing else breaks.
VITE_YOUTUBE_API_KEY=
